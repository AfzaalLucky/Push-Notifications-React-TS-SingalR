# .gitignore for the frontend (create-react-app)

# dependencies
node_modules/

# build output
build/

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local
.env

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor directories and files
.vscode/
.idea/
.DS_Store

# test coverage
coverage/

# cache
.cache/
